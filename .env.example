# Copy to .env – every value is optional and can also be set in the web UI (Settings).
# Values set here override the UI and are shown as locked there.

# Threat intel
VT_API_KEY=
OTX_API_KEY=
URLSCAN_API_KEY=
ANYRUN_API_KEY=
ABUSECH_AUTH_KEY=
# optional: faster CVSS lookups (CISA KEV / FIRST EPSS / NVD work without a key)
NVD_API_KEY=

# Social
X_BEARER_TOKEN=

# LLM: none | ollama | openai_compatible | anthropic
LLM_PROVIDER=none
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1
LLM_API_KEY=
# ANTHROPIC_API_KEY=   (used automatically when LLM_PROVIDER=anthropic and LLM_API_KEY is empty)

# Storage (default: SQLite in ./data). Example Postgres:
# JATMP_DATABASE_URL=postgresql+psycopg://jatmp:secret@db:5432/jatmp
