# Copy to .env – every value is optional and can also be set in the web UI (Settings).
# Values set here override the UI and are shown as locked there.

# Threat intel
VT_API_KEY=
OTX_API_KEY=
URLSCAN_API_KEY=
ANYRUN_API_KEY=
ABUSECH_AUTH_KEY=
# optional: faster CVSS lookups (CISA KEV / FIRST EPSS / NVD work without a key)
NVD_API_KEY=
GREYNOISE_API_KEY=
ABUSEIPDB_API_KEY=
# ransomware.live: the free PRO key is required for organisational use
RANSOMWARELIVE_API_KEY=
HUDSONROCK_API_KEY=
# Infrastructure context, used on demand ("Context lookup" on indicator pages)
SHODAN_API_KEY=
CENSYS_API_TOKEN=
CENSYS_ORG_ID=
CROWDSEC_API_KEY=
PULSEDIVE_API_KEY=
HYBRID_ANALYSIS_API_KEY=
IPINFO_TOKEN=

# MISP (pull events as a source, push items / families as events)
MISP_URL=
MISP_API_KEY=

# Optional PostgreSQL (docker compose --profile postgres); empty = SQLite in the data directory
JATMP_WITH_POSTGRES=0
JATMP_DB_PASSWORD=
JATMP_DATABASE_URL=

# Public base URL for links in API output, webhooks and MISP events (optional)
JATMP_PUBLIC_URL=

# Social
X_BEARER_TOKEN=

# LLM: none | ollama | openai_compatible | anthropic
LLM_PROVIDER=none
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1
LLM_API_KEY=
# ANTHROPIC_API_KEY=   (used automatically when LLM_PROVIDER=anthropic and LLM_API_KEY is empty)

# Storage (default: SQLite in ./data). Example Postgres:
# JATMP_DATABASE_URL=postgresql+psycopg://jatmp:secret@db:5432/jatmp
